@model ElegantEventsWeb.Models.Client

@{
    ViewData["Title"] = "Add New Client";
}

<div class="container mt-4">
    <h1>Add New Client</h1>
    <p class="text-muted">
        Enter the client's information below.
    </p>

    <form asp-controller="Clients"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Cfname" class="form-label">
                First Name
            </label>
            <input asp-for="Cfname"
                   class="form-control"
                   maxlength="30" required />
        </div>

        <div class="mb-3">
            <label asp-for="Clname" class="form-label">
                Last Name
            </label>
            <input asp-for="Clname"
                   class="form-control"
                   maxlength="30" required />
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">
                Phone
            </label>
            <input asp-for="Phone"
                   class="form-control"
                   maxlength="10" />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Email
            </label>
            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   maxlength="50" />
        </div>

        <div class="mb-3">
            <label asp-for="BillingAddress" class="form-label">
                Billing Address
            </label>
            <input asp-for="BillingAddress"
                   class="form-control"
                   maxlength="60" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Client
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
