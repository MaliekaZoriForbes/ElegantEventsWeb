@model ElegantEventsWeb.Models.Client

@{
    ViewData["Title"] = "Edit Client";
}

<div class="container mt-4">
    <h1>Edit Client</h1>
    <p class="text-muted">Update the client's information.</p>

    <form asp-controller="Clients"
          asp-action="Edit"
          asp-route-id="@Model.Client_ID"
          method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Client_ID" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="Cfname" class="form-control"
                   maxlength="30" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="Clname" class="form-control"
                   maxlength="30" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control"
                   maxlength="10" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email"
                   class="form-control" maxlength="50" />
        </div>

        <div class="mb-3">
            <label class="form-label">Billing Address</label>
            <input asp-for="BillingAddress"
                   class="form-control" maxlength="60" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
