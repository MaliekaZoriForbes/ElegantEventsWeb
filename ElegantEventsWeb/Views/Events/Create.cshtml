@model ElegantEventsWeb.Models.Event

@{
    ViewData["Title"] = "Book New Event";
}

<div class="container mt-4">
    <h1>Book New Event</h1>
    <p class="text-muted">
        Create an event and reserve a venue.
    </p>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Event ID</label>
            <input asp-for="Event_ID"
                   class="form-control"
                   maxlength="10" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Event Name</label>
            <input asp-for="Event_Name"
                   class="form-control"
                   maxlength="15" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Event Date</label>
            <input asp-for="Event_Date"
                   type="date"
                   asp-format="{0:yyyy-MM-dd}"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Number of Guests</label>
            <input asp-for="NumberOfGuests"
                   type="number"
                   min="1"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Budget (JMD)</label>
            <input asp-for="Budget"
                   type="number"
                   min="0.01"
                   step="0.01"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Client</label>
            <select asp-for="Client_ID"
                    asp-items="ViewBag.Clients"
                    class="form-select" required>
                <option value="">Select a client</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Venue</label>
            <select asp-for="VenueName"
                    asp-items="ViewBag.Venues"
                    class="form-select" required>
                <option value="">Select a venue</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Book Event
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
