@model ElegantEventsWeb.Models.Payment

@{
    ViewData["Title"] = "Record Payment";
}

<div class="container mt-4">
    <h1>Record New Payment</h1>

    <p class="text-muted">
        Select a contract and enter the payment details.
    </p>

    <form asp-controller="Payments"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Contract</label>

            <select name="contractKey"
                    asp-items="ViewBag.Contracts"
                    class="form-select"
                    required>
                <option value="">Select a contract</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="AmountPaid" class="form-label">
                Payment Amount (JMD)
            </label>

            <input asp-for="AmountPaid"
                   type="number"
                   min="0.01"
                   step="0.01"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="MethodPay" class="form-label">
                Payment Method
            </label>

            <select asp-for="MethodPay" class="form-select">
                <option value="Cash">Cash</option>
                <option value="Card">Card</option>
                <option value="Transfer">Bank Transfer</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Record Payment
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
