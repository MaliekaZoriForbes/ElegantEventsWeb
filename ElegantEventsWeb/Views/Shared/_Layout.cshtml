
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elegant Events</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ElegantEventsWeb.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home" asp-action="Index">
                    Elegant Events
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Clients"
                                   asp-action="Index">Clients</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Index">Events</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venues"
                                   asp-action="Index">Venues</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Vendors"
                                   asp-action="Index">Vendors</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Staff"
                                   asp-action="Index">Staff</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Contracts"
                                   asp-action="Index">Contracts</a>
                            </li>

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Payments"
                                       asp-action="Index">Payments</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Reports"
                                   asp-action="Index">Reports</a>
                            </li>
                        </ul>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-flex align-items-center gap-2">

                            @Html.AntiForgeryToken()

                            <span class="text-white-50 small">
                                @User.Identity.Name
                            </span>

                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-light btn-sm">
                                Login
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container-fluid px-4">
            &copy; 2026 - Elegant Events Management System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
