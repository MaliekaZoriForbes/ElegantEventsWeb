@model IEnumerable<ElegantEventsWeb.Models.Staff>

@{
    ViewData["Title"] = "Staff Management";
}

<div class="container mt-4">
    <h1>Staff Management</h1>

    <p class="text-muted">
        View Elegant Events employees and their information.
    </p>

    <a asp-action="Assignments"
       class="btn btn-primary mb-3">
        View Event Assignments
    </a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Employee Number</th>
                <th>Full Name</th>
                <th>Date Hired</th>
                <th>Phone</th>
                <th>Salary (JMD)</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.EmpNumber</td>
                    <td>
                        @member.Fname
                        @member.Mname
                        @member.Lname
                    </td>
                    <td>@member.DateHired.ToString("dd MMM yyyy")</td>
                    <td>@member.Phone</td>
                    <td>@member.Salary.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
