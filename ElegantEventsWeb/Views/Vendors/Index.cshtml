@model IEnumerable<ElegantEventsWeb.Models.Vendor>

@{
    ViewData["Title"] = "Vendor Management";
}

<div class="container mt-4">
    <h1>Vendor Management</h1>

    <p class="text-muted">
        View and manage vendors for Elegant Events.
    </p>

    <a asp-controller="Vendors"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Add New Vendor
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Vendor Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Address</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Subvendor Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vendor in Model)
                {
                    <tr>
                        <td>@vendor.VEmail</td>
                        <td>@vendor.VFName</td>
                        <td>@vendor.VLName</td>
                        <td>@vendor.VAddress</td>
                        <td>@vendor.ContactPersonnel</td>
                        <td>@vendor.VPhone</td>
                        <td>@(vendor.SubvendorEmail ?? "None")</td>

                        
                        <td>
                            <a asp-action="Contracts"
                               asp-route-id="@vendor.VEmail"
                               class="btn btn-sm btn-info">
                                View Contracts
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@vendor.VEmail"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@vendor.VEmail"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>


                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
